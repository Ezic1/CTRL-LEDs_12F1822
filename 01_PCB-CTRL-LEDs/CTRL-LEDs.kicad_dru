(version 1)
(rule "DIY - Minimum Track Width"
    (constraint track_width (min 0.40mm))
    (severity error)
    (condition "A.Type == 'Track'"))
(rule "DIY - Preferred Copper Clearance"
	(constraint clearance (min 0.5mm))
	(condition "A.Net != B.Net")

	(severity warning))
(rule "DIY - Fine Pitch SMD Pad Clearance"
    (constraint clearance (min 0.20mm))
    (severity error)
    (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD'"))
(rule "DIY - Minimum THT Annular Ring"
    (constraint annular_width (min 0.40mm))
    (severity error)
    (condition "A.Type == 'Pad' && A.isPlated()"))
(rule "DIY - Hole to Copper Clearance"
	(constraint hole_clearance (min 0.4mm))
)
(rule "DIY - Hole to Hole Clearance"
	(constraint hole_to_hole (min 0.5mm))
)
(rule "DIY - Copper to Board Edge"
	(constraint edge_clearance (min 0.6mm))
)
